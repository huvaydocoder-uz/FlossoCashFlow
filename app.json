{
  "expo": {
    "name": "Flosso CashFlow",
    "slug": "flosso-cashflow",
    "version": "1.0.0",
    "scheme": "flossocashflow",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "uz.flosso.cashflow",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uz.flosso.cashflow",
      "adaptiveIcon": {
        "backgroundColor": "#720F12",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Flosso CashFlow",
      "shortName": "Flosso CashFlow",
      "lang": "uz",
      "themeColor": "#720F12",
      "backgroundColor": "#F8F1F0",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
