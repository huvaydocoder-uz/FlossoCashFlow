# Bu faylni nusxalab, nomini .env qiling va qiymatlarni to'ldiring:
#   copy .env.example .env
# Qiymatlar: Supabase Dashboard -> Project Settings -> API Keys.

# Loyiha manzili, masalan: https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Publishable kalit (sb_publishable_...) yoki eski "anon" kalit.
# DIQQAT: service_role / secret kalitni HECH QACHON bu yerga yozmang —
# EXPO_PUBLIC_* qiymatlar ilova ichiga ochiq holda kiritiladi.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
